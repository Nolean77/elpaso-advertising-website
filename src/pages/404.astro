---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
---

<BlogPostLayout
  title="Page Not Found — El Paso Advertising Solutions"
  description="The page you're looking for doesn't exist or has moved."
  canonicalUrl="https://elpasoadvertisingsolutions.com/404"
  noindex={true}
>
  <section class="not-found">
    <p class="not-found-code">404</p>
    <h1>This page took a wrong turn.</h1>
    <p>The page you're looking for doesn't exist or has moved. Let's get you back on track.</p>
    <p class="not-found-es">La página que buscas no existe o se ha movido.</p>
    <div class="not-found-actions">
      <a href="/" class="not-found-btn">Back to Home</a>
      <a href="/blog" class="not-found-link">Read the Blog</a>
      <a href="/#contact" class="not-found-link">Contact Us</a>
    </div>
  </section>
</BlogPostLayout>

<style>
  .not-found {
    max-width: 640px;
    margin: 0 auto;
    padding: 8rem 1.5rem 5rem;
    text-align: center;
  }
  .not-found-code {
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 800;
    line-height: 1;
    margin: 0 0 1rem;
    color: var(--accent);
  }
  .not-found h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0 0 1rem;
  }
  .not-found p {
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 0.75rem;
  }
  .not-found-es { font-size: 0.9rem; }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-top: 2rem;
  }
  .not-found-btn {
    background: var(--accent);
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }
  .not-found-link {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
